<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  PactFlow Checkstyle Suppressions
  Suppresses Checkstyle warnings on generated MapStruct mappers and JPA entity wrappers.
-->
<suppressions>
    <!-- Suppress all checks on generated MapStruct implementation classes -->
    <suppress checks=".*" files=".*Impl\.java$"/>
    <suppress checks=".*" files=".*MapperImpl\.java$"/>

    <!-- Suppress line length check on Flyway migration or long DTO constructors if needed -->
    <suppress checks="LineLength" files=".*Dto\.java$"/>
</suppressions>
